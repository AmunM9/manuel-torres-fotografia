# Copia este archivo a .env.local y rellena los valores reales.
# cp .env.example .env.local

# Cloudinary — cloud name es público; API key/secret solo en servidor/scripts
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# URL canónica del sitio (OG, sitemap, enlaces absolutos)
NEXT_PUBLIC_SITE_URL=https://www.manueltorres.com.co
